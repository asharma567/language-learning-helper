// Pre-render Sveta's fixed praise vocabulary (the "Vary your praise" list in
// buildAzureTutorSystemPrompt — tutor-conversation.ts) as base64-inlined mp3s,
// same pattern as render-fillers.mts / tutor-fillers.ts. These ~8 one-word
// sentences are re-synthesized via ElevenLabs multilingual_v2 on nearly every
// turn in PROD; pre-rendering them once eliminates that recurring credit spend.
//
// Voice: ElevenLabs Sarah (EXAVITQu4vr4xnSDxMaL) on multilingual_v2 to MATCH
// Sveta's main TTS voice — single voice = no accent transitions.
//
// Output: src/lib/tutor-praise.ts (generated — do not hand-edit).
// Run: ELEVENLABS_API_KEY=... npx tsx scripts/autoresearch/render-praise.mts
import { writeFile } from 'node:fs/promises';
import { synthesizeWithElevenLabs, ELEVENLABS_VOICE_SVETA } from '../../src/lib/elevenlabs-tts.ts';

// Keys are the normalized form (lowercase, ё→е, punctuation stripped) that
// src/pages/api/tutor/turn-stream.ts computes from each outgoing sentence.
const PRAISE = [
  { text: 'Молодец!', key: 'молодец' },
  { text: 'Точно!', key: 'точно' },
  { text: 'Классно!', key: 'классно' },
  { text: 'Ага!', key: 'ага' },
  { text: 'Да!', key: 'да' },
  { text: 'Хорошо!', key: 'хорошо' },
  { text: 'Верно!', key: 'верно' },
  { text: 'Ну вот!', key: 'ну вот' },
];

const apiKey = process.env.ELEVENLABS_API_KEY;
if (!apiKey) throw new Error('ELEVENLABS_API_KEY missing');

const entries: string[] = [];
for (const p of PRAISE) {
  const mp3 = await synthesizeWithElevenLabs(p.text, { apiKey }, {
    voiceId: ELEVENLABS_VOICE_SVETA, stability: 0.6,
  });
  entries.push(`  '${p.key}': '${Buffer.from(mp3).toString('base64')}',`);
  console.log(`  rendered ${p.key} (${mp3.byteLength} bytes)`);
}

const out = `// Pre-rendered praise mp3s as base64. GENERATED by
// scripts/autoresearch/render-praise.mts — do not hand-edit; re-run the
// script to change the vocabulary or voice.
// Voice: ElevenLabs Sarah on multilingual_v2 to MATCH Sveta's main TTS voice.
// Keyed by normalized sentence (lowercase, ё→е, punctuation stripped) — see
// praiseKey() in src/pages/api/tutor/turn-stream.ts.

export const PRAISE_AUDIO_B64: Record<string, string> = {
${entries.join('\n')}
};
`;

await writeFile('src/lib/tutor-praise.ts', out);
console.log(`wrote src/lib/tutor-praise.ts (${PRAISE.length} praise clips)`);
